# ==============================================================================
# CẤU HÌNH HỆ THỐNG PAYSPLIT (DEVELOPMENT / LOCAL EXAMPLE)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ứng dụng và Vai trò Runtime
# ------------------------------------------------------------------------------
# Môi trường chạy ứng dụng: development | staging | production
APP_ENV=development

# Vai trò chạy ứng dụng (Spec 0010):
# - api: Chế độ serverless trên Vercel, chỉ phục vụ HTTP request, không chạy background worker loop.
# - worker: Chỉ chạy background worker (nếu có server riêng).
# - all: Chạy cả API lẫn background worker (dùng khi chạy binary local truyền thống).
APP_RUNTIME_ROLE=api

# ------------------------------------------------------------------------------
# 2. Cấu hình HTTP Server & Bảo mật Mạng
# ------------------------------------------------------------------------------
HTTP_HOST=localhost
HTTP_PORT=8080
HTTP_REQUEST_TIMEOUT_SECONDS=15
HTTP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
HTTP_RATE_LIMIT_REQUESTS_PER_MINUTE=300
HTTP_INVITE_ATTEMPTS_PER_MINUTE=30

# ------------------------------------------------------------------------------
# 3. Cơ sở dữ liệu PostgreSQL (Supabase Supavisor)
# ------------------------------------------------------------------------------
# URL kết nối cơ sở dữ liệu. Trên production với Supabase, sử dụng cổng 6543 (Transaction Pooler).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/paysplit?sslmode=disable
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/paysplit_test?sslmode=disable

# Chế độ pool kết nối: transaction (cho cổng 6543 của Supabase) hoặc session (cho cổng 5432)
DB_POOL_MODE=transaction

# Giới hạn số lượng kết nối cho mỗi Vercel Function invocation (Spec 0010 khuyến nghị max 2 đến 6)
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME_MINUTES=60
DB_MAX_CONN_IDLE_MINUTES=15
DB_HEALTH_CHECK_SECONDS=30
DB_ACQUIRE_TIMEOUT_MS=1000
DB_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=5
DB_APPLICATION_NAME=paysplit-api

# ------------------------------------------------------------------------------
# 4. Xác thực, Phiên Đăng Nhập & JWT
# ------------------------------------------------------------------------------
# Khóa bí mật dùng để ký và xác thực Access Token JWT (HS256)
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=paysplit-backend
JWT_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_HOURS=168
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=10
AUTH_PASSWORD_RESET_TTL_MINUTES=10

# Đường dẫn deeplink mở ứng dụng khi người dùng nhấn vào email xác thực hoặc đổi mật khẩu
AUTH_EMAIL_VERIFICATION_URL=paysplit://verify-email
AUTH_PASSWORD_RESET_URL=paysplit://reset-password

# ------------------------------------------------------------------------------
# 5. Liên kết Lời mời Nhóm
# ------------------------------------------------------------------------------
# Domain cơ sở cho đường link mời tham gia nhóm (ví dụ: https://paysplit.app/join/CODE)
APP_INVITE_BASE_URL=https://paysplit.app/join

# ------------------------------------------------------------------------------
# 6. Gửi Email (Gmail SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_APP_PASSWORD=replace-with-google-app-password
SMTP_FROM_NAME=PaySplit
SMTP_TIMEOUT_SECONDS=5

# ------------------------------------------------------------------------------
# 7. Lưu trữ Đám mây Cloudinary (Ảnh đại diện & Hóa đơn)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
AVATAR_UPLOAD_TIMEOUT_SECONDS=15
AVATAR_PROCESSING_TIMEOUT_SECONDS=10
AVATAR_MAX_CONCURRENT_CONVERSIONS=2

# ------------------------------------------------------------------------------
# 8. Dọn dẹp Định kỳ (Cleanup)
# ------------------------------------------------------------------------------
AUTH_CLEANUP_INTERVAL_HOURS=24
AUTH_RECORD_RETENTION_DAYS=30
MEDIA_CLEANUP_WORKER_INTERVAL_SECONDS=60
MEDIA_CLEANUP_MAX_ATTEMPTS=10

# ------------------------------------------------------------------------------
# 9. Hàng đợi Bền vững & Điều phối Serverless (app_jobs, Dispatcher & Drain)
# ------------------------------------------------------------------------------
# Bật hoặc tắt tính năng xử lý background job
JOB_PROCESSING_ENABLED=true

# Mã bí mật bảo vệ endpoint /internal/jobs/dispatch và /internal/jobs/drain.
# Mã này cần được cấu hình giống nhau trên Vercel và trong Supabase Vault (để trigger pg_net gọi tới API).
JOB_TRIGGER_SECRET=replace-with-secure-bearer-token
CRON_SECRET=replace-with-secure-bearer-token

# Số lượng job tối đa xử lý trong 1 lượt drain invocation
JOB_BATCH_SIZE=5

# Ngân sách thời gian (timeout) và thời hạn khóa (lease) cho điều phối và xử lý job
JOB_DISPATCHER_TIMEOUT_SECONDS=5
JOB_DISPATCHER_LEASE_SECONDS=15
JOB_INVOCATION_TIMEOUT_SECONDS=45
JOB_STOP_CLAIMING_AFTER_SECONDS=40
JOB_EXTERNAL_TIMEOUT_SECONDS=35
JOB_LEASE_SECONDS=75
JOB_DRAIN_SLOT_LEASE_SECONDS=75

# Timeout khi gọi pg_net từ PostgreSQL sang Vercel Function
PG_NET_DISPATCH_TIMEOUT_MS=10000
PG_NET_DRAIN_TIMEOUT_MS=55000

# Lựa chọn backend hàng đợi (app_jobs hoặc river trong giai đoạn chuyển đổi)
JOB_BACKEND_NOTIFICATION=app_jobs
JOB_BACKEND_OCR=app_jobs
JOB_BACKEND_BULK_FINALIZE=app_jobs
JOB_BACKEND_CLEANUP=app_jobs
JOB_BACKEND_SETTLEMENT=app_jobs
APP_JOB_ENABLED_KINDS=notification.push,ocr.process,bill.bulk_finalize_item,settlement.reminder_scan,settlement.stalled_scan,media_auth.cleanup,raw_ocr.retention,group_events.retention

# ------------------------------------------------------------------------------
# 10. Supabase Realtime Broadcast & Khóa ký ES256 JWT
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-or-anon-key

# Khóa bí mật ECDSA P-256 (dạng PEM) dùng để ký short-lived JWT cho client Flutter kết nối Supabase Realtime.
# Nếu để trống ở môi trường test/dev, backend sẽ tự động sinh ephemeral key tạm thời.
SUPABASE_REALTIME_JWT_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\nreplace-with-p256-pem-private-key\n-----END EC PRIVATE KEY-----"
SUPABASE_REALTIME_JWT_KID=realtime-v1
SUPABASE_REALTIME_JWT_ISSUER=supabase
SUPABASE_REALTIME_JWT_AUDIENCE=authenticated
REALTIME_TOKEN_TTL_SECONDS=300
REALTIME_CLOCK_SKEW_SECONDS=60

# Chế độ đồng bộ cho ứng dụng di động: supabase (sử dụng Realtime Broadcast) hoặc polling (chỉ fallback polling)
MOBILE_REALTIME_MODE=supabase
REALTIME_POLL_INTERVAL_SECONDS=10
REALTIME_POLL_JITTER_PERCENT=20
REALTIME_MAX_GROUP_CHANNELS=10

# ------------------------------------------------------------------------------
# 11. Cơ chế Đồng bộ Hợp nhất (/api/v1/sync/versions)
# ------------------------------------------------------------------------------
SYNC_VERSIONS_PAGE_LIMIT=500
SYNC_VERSIONS_MAX_BYTES=262144
SYNC_VERSIONS_MAX_PAGES_PER_CYCLE=4

# Khóa bí mật dùng để ký chữ ký HMAC chống giả mạo cursor phân trang
SYNC_CURSOR_HMAC_KEY=replace-with-32-byte-hex-or-base64-secret

# ------------------------------------------------------------------------------
# 12. Quét Hóa đơn AI (LlamaExtract OCR)
# ------------------------------------------------------------------------------
LLAMAINDEX_API_KEY=replace-with-llamaindex-api-key
LLAMAINDEX_EXTRACT_ENDPOINT=https://api.cloud.llamaindex.ai
BILL_OCR_PROVIDER_TIMEOUT_SECONDS=45
BILL_OCR_MAX_ATTEMPTS=3
BILL_OCR_RETRY_BASE_DELAY_SECONDS=1
BILL_OCR_MANUAL_LIMIT=5
BILL_OCR_MANUAL_WINDOW_HOURS=24
BILL_OCR_RAW_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 13. Quản lý Ảnh Hóa đơn
# ------------------------------------------------------------------------------
BILL_IMAGE_MAX_COUNT=5
BILL_IMAGE_MAX_BYTES=10485760
BILL_IMAGE_UPLOAD_TIMEOUT_SECONDS=15
BILL_IMAGE_PROCESSING_TIMEOUT_SECONDS=10
BILL_IMAGE_SIGNED_URL_TTL_MINUTES=5

# ------------------------------------------------------------------------------
# 14. Thanh toán, Minh chứng & Dynamic VietQR
# ------------------------------------------------------------------------------
VIETQR_SERVICE_BASE_URL=https://img.vietqr.io/image
VIETQR_TEMPLATE=compact
PAYMENT_PROOF_MAX_BYTES=10485760
PAYMENT_PROOF_SIGNED_URL_TTL=300
PAYMENT_REMINDER_STALE_HOURS=72
PAYMENT_REMINDER_MAX_COUNT=3
STALLED_CONFIRMATION_HOURS=48

# ------------------------------------------------------------------------------
# 15. Thông báo Đẩy Firebase (FCM)
# ------------------------------------------------------------------------------
FCM_TIMEOUT_SECONDS=5
FIREBASE_CREDENTIALS_FILE=service-account.json
FIREBASE_CREDENTIALS_JSON='{......}'
