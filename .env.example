APP_ENV=development
HTTP_ADDRESS=:8080
HTTP_REQUEST_TIMEOUT_SECONDS=15
HTTP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
HTTP_RATE_LIMIT_REQUESTS_PER_MINUTE=30
DATABASE_URL=postgres://postgres:postgres@localhost:5432/paysplit?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME_MINUTES=60
DB_MAX_CONN_IDLE_MINUTES=15
DB_HEALTH_CHECK_SECONDS=30
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=paysplit-backend
JWT_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_HOURS=168
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=10
AUTH_PASSWORD_RESET_TTL_MINUTES=10
AUTH_EMAIL_VERIFICATION_URL=paysplit://verify-email
AUTH_PASSWORD_RESET_URL=paysplit://reset-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_APP_PASSWORD=replace-with-google-app-password
SMTP_FROM_NAME=PaySplit
SMTP_TIMEOUT_SECONDS=5
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
AVATAR_UPLOAD_TIMEOUT_SECONDS=15
AVATAR_PROCESSING_TIMEOUT_SECONDS=10
AVATAR_MAX_CONCURRENT_CONVERSIONS=2
AUTH_CLEANUP_INTERVAL_HOURS=24
AUTH_RECORD_RETENTION_DAYS=30
MEDIA_CLEANUP_WORKER_INTERVAL_SECONDS=60
MEDIA_CLEANUP_MAX_ATTEMPTS=10
