# Application
# CHUA DAT nghia la KHONG PHAI development, va cac rang buoc van hanh se bat buoc
# (xem REDIS_URL ben duoi). Chi dat tuong minh la `development` moi duoc noi.
APP_ENV=development

# HTTP server
HTTP_HOST=localhost
HTTP_PORT=8080
HTTP_REQUEST_TIMEOUT_SECONDS=15
HTTP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
HTTP_RATE_LIMIT_REQUESTS_PER_MINUTE=300
HTTP_INVITE_ATTEMPTS_PER_MINUTE=30

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5433/paysplit?sslmode=disable
# Tùy chọn: URL kết nối riêng cho Realtime Listener (LISTEN/NOTIFY).
# Mặc định để trống sẽ dùng chung DATABASE_URL. Cần cấu hình khi DATABASE_URL dùng Transaction Pooler (:6543)
# thì DATABASE_LISTENER_URL phải trỏ tới Direct endpoint hoặc Session Pooler (:5432) do LISTEN yêu cầu session state.
DATABASE_LISTENER_URL=
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/paysplit_test?sslmode=disable
DB_APPLICATION_NAME=paysplit-api
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME_MINUTES=60
DB_MAX_CONN_IDLE_MINUTES=15
DB_HEALTH_CHECK_SECONDS=30

# Authentication (email verification & password reset)
# Vòng đời phiên đăng nhập nằm ở nhóm "Redis session store" bên dưới.
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=10
AUTH_PASSWORD_RESET_TTL_MINUTES=10
AUTH_EMAIL_VERIFICATION_URL=paysplit://verify-email
AUTH_PASSWORD_RESET_URL=paysplit://reset-password

# Group settings
APP_INVITE_BASE_URL=https://paysplit.app/join
# Số lượng thành viên hoạt động (active) tối đa trong một nhóm (mặc định: 50).
# Giới hạn này giúp đảm bảo hiệu năng tính toán thuật toán chia tiền (Hamilton Largest-Remainder)
# và tối ưu trải nghiệm người dùng khi chọn thành viên trên màn hình thiết bị di động.
# GROUP_MAX_ACTIVE_MEMBERS=50

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_APP_PASSWORD=replace-with-google-app-password
SMTP_FROM_NAME=PaySplit
SMTP_TIMEOUT_SECONDS=5

# Cloudinary and avatar images
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
AVATAR_UPLOAD_TIMEOUT_SECONDS=15
AVATAR_PROCESSING_TIMEOUT_SECONDS=10
AVATAR_MAX_CONCURRENT_CONVERSIONS=2

# Cleanup workers
AUTH_CLEANUP_INTERVAL_HOURS=24
AUTH_RECORD_RETENTION_DAYS=30
MEDIA_CLEANUP_WORKER_INTERVAL_SECONDS=60
MEDIA_CLEANUP_MAX_ATTEMPTS=10

# River queue
RIVER_WORKER_COUNT=5
RIVER_FETCH_COOLDOWN_MS=100
RIVER_POLL_ONLY=false
RIVER_FETCH_POLL_INTERVAL_MS=1000

# LlamaIndex OCR
LLAMAINDEX_API_KEY=replace-with-llamaindex-api-key
LLAMAINDEX_EXTRACT_ENDPOINT=https://api.cloud.llamaindex.ai
BILL_OCR_PROVIDER_TIMEOUT_SECONDS=45
BILL_OCR_MAX_ATTEMPTS=3
BILL_OCR_RETRY_BASE_DELAY_SECONDS=1
BILL_OCR_MANUAL_LIMIT=5
BILL_OCR_MANUAL_WINDOW_HOURS=24
BILL_OCR_RAW_RETENTION_DAYS=30
# Job OCR đứng yên ở queued/processing quá ngưỡng này sẽ bị reaper đánh 'failed'.
BILL_OCR_STALE_JOB_AGE_MINUTES=15

# Bill image storage
BILL_IMAGE_MAX_COUNT=5
BILL_IMAGE_MAX_BYTES=10485760
BILL_IMAGE_UPLOAD_TIMEOUT_SECONDS=15
BILL_IMAGE_PROCESSING_TIMEOUT_SECONDS=10
BILL_IMAGE_SIGNED_URL_TTL_MINUTES=5

# Bill event stream
BILL_SSE_HEARTBEAT_INTERVAL_SECONDS=15
BILL_SSE_MAX_CONNECTION_AGE_MINUTES=15

# Group realtime sync
GROUP_SSE_HEARTBEAT_INTERVAL_SECONDS=15
GROUP_SSE_MAX_CONNECTION_AGE_MINUTES=15
GROUP_EVENT_RETENTION_DAYS=7

# User realtime stream
# Mặc định tắt để rollout có chủ đích. Bật true ở môi trường đã sẵn sàng.
USER_SSE_ENABLED=false
# Định dạng bắt buộc: major.minor.patch+build, ví dụ 1.0.0+1.
# Để trống nếu môi trường không cần chặn client cũ.
REALTIME_MIN_USER_STREAM_APP_VERSION=

# Settlement and VietQR
VIETQR_SERVICE_BASE_URL=https://img.vietqr.io/image
VIETQR_TEMPLATE=compact
PAYMENT_PROOF_MAX_BYTES=10485760
PAYMENT_PROOF_SIGNED_URL_TTL=300
PAYMENT_REMINDER_STALE_HOURS=72
PAYMENT_REMINDER_MAX_COUNT=3
STALLED_CONFIRMATION_HOURS=48

# Firebase notifications
# Chọn 1 trong 2: FIREBASE_CREDENTIALS_FILE (đường dẫn file) hoặc FIREBASE_CREDENTIALS_JSON (nội dung JSON khi deploy)
# Ưu tiên FIREBASE_CREDENTIALS_JSON, nếu rỗng thì mới dùng FIREBASE_CREDENTIALS_FILE
FCM_TIMEOUT_SECONDS=5
FIREBASE_CREDENTIALS_FILE=service-account.json
FIREBASE_CREDENTIALS_JSON='{......}'

# Redis session store
# maxmemory-policy PHẢI là noeviction (xem docker-compose.yaml): allkeys-lru là
# policy cho cache, nó sẽ âm thầm xoá phiên của người dùng ít hoạt động khi đầy
# RAM, khiến họ bị đăng xuất ngẫu nhiên mà không có log nào. Từ nay ứng dụng tự
# kiểm giá trị này lúc khởi động và dừng nếu sai (bỏ qua khi Redis được quản lý
# chặn CONFIG GET). Trừ khi APP_ENV được đặt tường minh là development, REDIS_URL
# bắt buộc phải mang mật khẩu ở phần userinfo, ví dụ redis://:matkhau@host:6379/0.
# Quên đặt APP_ENV cũng bị coi là ngoài development, nên ràng buộc vẫn có hiệu lực.
REDIS_URL=redis://:devpassword@localhost:6380/0
REDIS_PASSWORD=devpassword
REDIS_POOL_SIZE=20
REDIS_DIAL_TIMEOUT_SECONDS=5
REDIS_READ_TIMEOUT_SECONDS=2
# TTL trượt: mỗi request có xác thực đều gia hạn lại phiên.
SESSION_IDLE_TTL_HOURS=168
# Trần cứng: phiên chết sau mốc này dù người dùng có hoạt động liên tục.
# AUTH_RECORD_RETENTION_DAYS phải >= (ABSOLUTE - IDLE) để worker dọn rác không
# xoá mất bản ghi audit của phiên vẫn còn sống.
SESSION_ABSOLUTE_TTL_HOURS=720

# Integration tests (bỏ trống thì mọi *_integration_test.go bị skip im lặng)
TEST_REDIS_URL=redis://:devpassword@localhost:6380/1
