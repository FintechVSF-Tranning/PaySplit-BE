# Copy thanh deploy/.env tren VM. File nay CHI phuc vu Docker Compose interpolation,
# khong phai config cua app (config app nam o ../.env.production).

# Mat khau PostgreSQL noi bo.
# BAT BUOC dung -hex, KHONG dung -base64: alphabet Base64 chua '/', '+', '=' —
# dau '/' ket thuc phan authority cua URI, lam vo DATABASE_URL ma compose dung
# de dung chuoi ket noi (postgres://paysplit:${POSTGRES_PASSWORD}@postgres:5432/...).
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Hostname public de Caddy xin chung chi Let's Encrypt.
# Tam thoi (khong can mua domain): <IP>.nip.io  vi du 161.118.233.21.nip.io
# Chinh thuc: api.paysplit.example.com (tro A record ve IP cua VM)
SITE_ADDRESS=
